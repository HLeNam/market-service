# Binance API Configuration
BINANCE_API_URL=https://api.binance.com/api/v3

# Quote Assets (comma-separated)
# Supported: USDT, BUSD, BTC, ETH, BNB, USDC, TUSD, EUR, GBP, etc.
# Default: USDT
QUOTE_ASSETS=USDT

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Database Configuration (adjust according to your setup)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=
# DB_NAME=market_service
