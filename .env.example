# Application
NODE_ENV=development
PORT=3001

# Database
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=123456789
DATABASE_NAME=market_db
DATABASE_SYNC=false
DATABASE_LOGGING=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# External Services
NEWS_SERVICE_URL=http://localhost:3002/api/v1
AI_SERVICE_URL=http://localhost:3003/api/v1
AUTH_SERVICE_URL=http://localhost:3004/api/v1

# Binance API
BINANCE_API_URL=https://api.binance.com/api/v3
BINANCE_WS_URL=wss://stream.binance.com:9443

# Binance WebSocket Configuration
# Max retry attempts before giving up (default: 10)
WS_MAX_RETRY_ATTEMPTS=
# Initial retry delay in milliseconds (default: 1000)
WS_INITIAL_RETRY_DELAY=
# Maximum retry delay in milliseconds (default: 60000)
WS_MAX_RETRY_DELAY=
# Ping interval in milliseconds (default: 30000)
WS_PING_INTERVAL=
# Pong timeout in milliseconds (default: 10000)
WS_PONG_TIMEOUT=

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# JWT (if needed for auth)
JWT_SECRET=your-secret-key-here
JWT_EXPIRATION=1d

# Monitoring (Optional)
SENTRY_DSN=
PROMETHEUS_PORT=9090

# Logging
LOG_LEVEL=debug

# Quote Assets (comma-separated)
# Supported: USDT, BUSD, BTC, ETH, BNB, USDC, TUSD, EUR, GBP, etc.
# Default: USDT
QUOTE_ASSETS=

FRONTEND_URL=http://localhost:5173