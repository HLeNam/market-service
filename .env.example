# Application
NODE_ENV=
PORT=

# Database
DATABASE_TYPE=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_SYNC=
DATABASE_LOGGING=

# Redis
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_URL=

# External Services
NEWS_SERVICE_URL=
AI_SERVICE_URL=
AUTH_SERVICE_URL=

# Binance API
BINANCE_API_URL=
BINANCE_WS_URL=

# Binance WebSocket Configuration
# Max retry attempts before giving up (default: 10)
WS_MAX_RETRY_ATTEMPTS=
# Initial retry delay in milliseconds (default: 1000)
WS_INITIAL_RETRY_DELAY=
# Maximum retry delay in milliseconds (default: 60000)
WS_MAX_RETRY_DELAY=
# Ping interval in milliseconds (default: 30000)
WS_PING_INTERVAL=
# Pong timeout in milliseconds (default: 10000)
WS_PONG_TIMEOUT=

# Rate Limiting
THROTTLE_TTL=
THROTTLE_LIMIT=

# JWT (if needed for auth)
JWT_SECRET=
JWT_EXPIRATION=

# Monitoring (Optional)
SENTRY_DSN=
PROMETHEUS_PORT=

# Logging
LOG_LEVEL=

# Quote Assets (comma-separated)
# Supported: USDT, BUSD, BTC, ETH, BNB, USDC, TUSD, EUR, GBP, etc.
# Default: USDT
QUOTE_ASSETS=
